{
  "name": "a2a-mcp-agent-studio-backend",
  "version": "1.0.0",
  "description": "A2A + MCP Agent Studio Backend for American Express card replacement and charge verification",
  "scripts": {
    "start:ava": "cd agents/orchestrator && npx tsx server.ts",
    "start:charge-verification": "cd agents/charge-verification && npx tsx server.ts",
    "start:card-replacement": "cd agents/card-replacement && npx tsx server.ts",
    "start:address-confirmation": "cd mcp-servers/address-confirmation && npx tsx server.ts",
    "start:delivery-method": "cd mcp-servers/delivery-method && npx tsx server.ts",
    "start:replacement-reason": "cd mcp-servers/replacement-reason && npx tsx server.ts",
    "start:final-submission": "cd mcp-servers/final-submission && npx tsx server.ts",
    "start:all": "concurrently \"npm run start:ava\" \"npm run start:charge-verification\" \"npm run start:card-replacement\" \"npm run start:address-confirmation\" \"npm run start:delivery-method\" \"npm run start:replacement-reason\" \"npm run start:final-submission\"",
    "start:agents": "concurrently \"npm run start:ava\" \"npm run start:charge-verification\" \"npm run start:card-replacement\"",
    "start:mcp": "concurrently \"npm run start:address-confirmation\" \"npm run start:delivery-method\" \"npm run start:replacement-reason\" \"npm run start:final-submission\"",
    "build": "tsc",
    "dev:ava": "cd agents/orchestrator && npx tsx --watch server.ts",
    "dev:charge-verification": "cd agents/charge-verification && npx tsx --watch server.ts",
    "dev:card-replacement": "cd agents/card-replacement && npx tsx --watch server.ts",
    "dev:address-confirmation": "cd mcp-servers/address-confirmation && npx tsx --watch server.ts",
    "dev:delivery-method": "cd mcp-servers/delivery-method && npx tsx --watch server.ts",
    "dev:replacement-reason": "cd mcp-servers/replacement-reason && npx tsx --watch server.ts",
    "dev:final-submission": "cd mcp-servers/final-submission && npx tsx --watch server.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "openai": "^6.37.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
